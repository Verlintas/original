---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Circle from '../../components/Circle.astro';
import { formatDate } from '../../utils/format';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="NOTES" description="Short pieces of writing published on Original.">
  <h1 class="page-title"><Circle /> NOTES</h1>
  <p class="lede">
    Short pieces of writing: announcements, explanations, and the occasional thought.
    Newest first.
  </p>

  <ul class="entry-list">
    {
      notes.map((entry) => (
        <li class="entry">
          <h3 class="entry-title">
            <a href={`/notes/${entry.id}/`}><Circle /><span>{entry.data.title}</span></a>
          </h3>
          <p class="entry-meta">{formatDate(entry.data.date)}</p>
          <p class="entry-summary">{entry.data.summary}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
