---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import Circle from '../../components/Circle.astro';
import { formatDate } from '../../utils/format';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection('guides')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const index = all.findIndex((item) => item.id === entry.id);
const previous = index > 0 ? all[index - 1] : null;
const next = index >= 0 && index < all.length - 1 ? all[index + 1] : null;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: entry.data.title,
    description: entry.data.summary,
    dateModified: formatDate(entry.data.updated),
    author: { "@type": "Organization", name: "Original" },
    mainEntityOfPage: new URL(`/guides/${entry.id}/`, Astro.site ?? new URL('https://original.wales')).href,
  })} />
  <p class="back"><a href="/guides/">← All guides</a></p>

  <header class="file-head">
    <h1 class="page-title"><Circle /> {entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    <p class="guide-byline">
      {entry.data.audience} · {entry.data.readingTime} · Updated {formatDate(entry.data.updated)}
    </p>
  </header>

  <div class="detail-grid">
    <div class="prose">
      <Content />

      <nav class="guide-pager" aria-label="Guide navigation">
        {previous ? <a href={`/guides/${previous.id}/`}>← {previous.data.title}</a> : <span></span>}
        {next ? <a href={`/guides/${next.id}/`}>{next.data.title} →</a> : <span></span>}
      </nav>
    </div>

    <aside class="meta-aside" aria-label="Guide metadata">
      <h2>About this guide</h2>
      <dl class="meta-list">
        <div><dt>Audience</dt><dd>{entry.data.audience}</dd></div>
        <div><dt>Reading</dt><dd>{entry.data.readingTime}</dd></div>
        <div><dt>Updated</dt><dd>{formatDate(entry.data.updated)}</dd></div>
        {entry.data.tags.length > 0 && (
          <div><dt>Tags</dt><dd>{entry.data.tags.join(' · ')}</dd></div>
        )}
      </dl>
      <p class="kit-note">
        This guide is general information, not legal advice. Read the linked primary sources before
        relying on a document.
      </p>
    </aside>
  </div>

  <p class="back" style="margin-top: 3rem;"><a href="/guides/">← All guides</a></p>
</BaseLayout>
