---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="CLI"
  description="A full-screen terminal interface to Original, for humans and scripts."
  noindex
  bare
  theme="cli"
>
  <div class="cli-screen">
    <div class="cli-topbar">
      <a class="cli-brand" href="/">◯ ORIGINAL — SHELL</a>
      <span class="cli-hintline">
        help · manual: /cli/manual.txt · agents: /AGENTS.md
      </span>
      <a class="cli-back" href="/">[ BACK TO SITE ]</a>
    </div>

    <div class="cli-output" id="cli-output" role="log" aria-live="polite"></div>

    <form class="cli-inputbar" id="cli-form">
      <label class="cli-prompt" id="cli-prompt" for="cli-input">original / $</label>
      <input
        class="cli-input"
        id="cli-input"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-label="Command"
      />
    </form>

    <noscript>
      <p class="cli-noscript">
        The interactive terminal needs JavaScript. Static endpoints:
        <a href="/cli/help.txt">/cli/help.txt</a> ·
        <a href="/cli/ls.txt">/cli/ls.txt</a> ·
        <a href="/cli/files.txt">/cli/files.txt</a> ·
        <a href="/index.json">/index.json</a> ·
        <a href="/search.json">/search.json</a>
      </p>
    </noscript>
  </div>

  <script>
    const output = document.getElementById('cli-output');
    const form = document.getElementById('cli-form');
    const input = document.getElementById('cli-input');
    const promptEl = document.getElementById('cli-prompt');

    const COMMANDS = [
      'help', 'manual', 'agents', 'api', 'ls', 'cd', 'pwd', 'tree', 'files',
      'cat', 'read', 'head', 'tail', 'search', 'context', 'cite', 'related',
      'verify', 'manifest', 'sitemap', 'licenses', 'resources', 'kits', 'guides', 'data', 'downloads', 'compare', 'download',
      'open', 'status', 'links', 'tools', 'contact', 'stats', 'about',
      'date', 'whoami', 'source', 'history', 'clear', 'exit', 'echo',
    ];

    const HELP = {
      help: 'help [command] — list commands or explain one.',
      manual: 'manual — print the full agent/CLI manual. Static: /cli/manual.txt',
      agents: 'agents — print agent onboarding. Static: /AGENTS.md',
      api: 'api — list machine endpoints and commands. Static: /cli/commands.json',
      ls: 'ls [-l] [path] — list the current directory, a section, or a files category. -l adds size and date.',
      cd: 'cd <path> — change directory: /, /files, /files/<category>, /guides, /data, /status, /universe, /about.',
      pwd: 'pwd — print the current path.',
      tree: 'tree — show the whole site tree.',
      files: 'files [category|tag] — list files, filtered by category or tag (for example COPYLEFT).',
      cat: 'cat <file> — metadata and summary for a file. Accepts a slug or path.',
      read: 'read <file> — print the complete text of a file.',
      head: 'head <file> [n] — print the first n lines (default 20).',
      tail: 'tail <file> [n] — print the last n lines (default 20).',
      search: 'search <term> — full-text search across every text file on the site.',
      context: 'context <file> — print metadata, citation, related files, and full text.',
      cite: 'cite <file> — print a one-line citation with version, date, URL, checksum.',
      related: 'related <file> — list files sharing a category or tags.',
      verify: 'verify <file> — download a file and check its SHA-256 against the published value.',
      manifest: 'manifest — print the TSV inventory. Static: /cli/manifest.tsv',
      sitemap: 'sitemap — print the plain-text site map. Static: /cli/sitemap.txt',
      licenses: 'licenses [id] — print the license feature matrix, or one license. Static: /cli/licenses.json',
      resources: 'resources [category] — print the official resource inventory. Static: /cli/resources.json',
      kits: 'kits — list downloadable kit bundles. Static: /kits/index.json',
      guides: 'guides — list plain-language guides. Static: /guides.json',
      data: 'data — list public datasets. Static: /data/index.json',
      downloads: 'downloads — list library and category archives. Static: /downloads/index.json',
      compare: 'compare <id...> — compare 2-6 licenses in text, for example: compare mit gpl-3.0 mpl-2.0',
      download: 'download <file> — start a download.',
      open: 'open <section|file|url> — open a page, file, or external URL.',
      status: 'status — GitHub platform status and site reachability.',
      links: 'links — list the site links.',
      tools: 'tools — list the browser tools in Universe.',
      contact: 'contact — email and GitHub contact details.',
      stats: 'stats — counts, total size, and index generation time.',
      about: 'about — one paragraph about the site.',
      date: 'date — current date and time.',
      whoami: 'whoami — identify the current visitor.',
      source: 'source — source repository URL.',
      history: 'history — command history.',
      clear: 'clear — clear the screen (Ctrl+L also works).',
      exit: 'exit — leave the shell and return to the site.',
      echo: 'echo <text> — print text.',
    };

    let index = null;
    let searchData = null;
    let cwd = '/';
    const history = [];
    let historyPos = 0;
    let busy = false;

    function print(text) {
      output.appendChild(document.createTextNode(text + '\n'));
      output.scrollTop = output.scrollHeight;
    }

    function printMuted(text) {
      const span = document.createElement('span');
      span.className = 'muted';
      span.textContent = text + '\n';
      output.appendChild(span);
      output.scrollTop = output.scrollHeight;
    }

    function jsonOut(value) {
      print(JSON.stringify(value, null, 2));
    }

    function setPrompt() {
      promptEl.textContent = 'original ' + cwd + ' $';
    }

    function normalizePath(raw) {
      const value = (raw || '').trim();
      const parts = (value.startsWith('/') ? value : cwd + '/' + (value || '.')).split('/');
      const out = [];
      for (const part of parts) {
        if (!part || part === '.') continue;
        if (part === '..') out.pop();
        else out.push(part);
      }
      return '/' + out.join('/');
    }

    function basename(p) {
      return p.split('/').filter(Boolean).pop() || p;
    }

    function categories() {
      return [...new Set(index.files.map((f) => f.category.toLowerCase()))];
    }

    function entriesInCategory(cat) {
      return index.files.filter((f) => f.category.toLowerCase() === cat);
    }

    function resolveEntry(target) {
      if (!index || !target) return null;
      const t = target.trim().toLowerCase();
      const direct = index.files.find(
        (f) => f.id === t || f.title.toLowerCase() === t || basename(f.download || '').toLowerCase() === t,
      );
      if (direct) return direct;
      const abs = normalizePath(target).toLowerCase();
      return (
        index.files.find((f) => f.download && normalizePath(f.download).toLowerCase() === abs) || null
      );
    }

    function sectionForPath(pathname) {
      if (!index) return null;
      return index.sections.find((s) => normalizePath(s.path) === pathname) || null;
    }

    function listDir(pathname) {
      if (!index) return null;
      if (pathname === '/') {
        const items = [];
        for (const section of index.sections) {
          if (section.path === '/') continue;
          items.push({
            kind: 'dir',
            name: section.name.toLowerCase(),
            description: section.description,
            path: section.path,
          });
        }
        items.push({ kind: 'file', name: 'index.json', description: 'Machine index (JSON).' });
        items.push({ kind: 'file', name: 'search.json', description: 'Full-text search data.' });
        items.push({ kind: 'file', name: 'llms.txt', description: 'Site description for AI agents.' });
        items.push({ kind: 'file', name: 'rss.xml', description: 'Feed of published files.' });
        return items;
      }
      if (pathname === '/files') {
        return categories().map((cat) => ({
          kind: 'dir',
          name: cat,
          description: entriesInCategory(cat).length + ' files',
          path: '/files/' + cat,
        }));
      }
      const cat = pathname.startsWith('/files/') ? pathname.slice('/files/'.length) : null;
      if (cat && categories().includes(cat)) {
        return entriesInCategory(cat).map((entry) => ({
          kind: 'file',
          name: entry.download ? basename(entry.download) : entry.id,
          description: entry.title,
          size: entry.size,
          date: entry.date,
          entry,
        }));
      }
      if (sectionForPath(pathname)) return [];
      return null;
    }

    function dirsOnly(pathname) {
      const items = listDir(pathname) || [];
      return items.filter((item) => item.kind === 'dir').map((item) => item.name + '/');
    }

    function printEntries(pathname, long) {
      const items = listDir(pathname);
      if (!items) return printMuted('Not a directory: ' + pathname);
      if (!items.length) return printMuted('(empty)');
      for (const item of items) {
        if (item.kind === 'dir') {
          print('  ' + (item.name + '/').padEnd(18) + item.description);
        } else if (item.entry) {
          const meta = long ? item.size + ' · ' + item.date + ' · ' + item.description : item.description;
          print('  ' + item.name.padEnd(34) + meta);
        } else {
          print('  ' + item.name.padEnd(18) + item.description);
        }
      }
    }

    function isWide() {
      return window.innerWidth >= 720;
    }

    function listFiles(filter, json) {
      const needle = (filter || '').toLowerCase();
      const items = needle
        ? index.files.filter(
            (f) =>
              f.category.toLowerCase() === needle ||
              (f.tags || []).some((tag) => tag.toLowerCase() === needle),
          )
        : index.files;
      if (!items.length) {
        return json
          ? jsonOut({ filter: filter || null, files: [] })
          : printMuted('No files for category or tag: ' + filter);
      }
      if (json) {
        return jsonOut({ filter: filter || null, files: items });
      }
      if (isWide()) {
        print('  ' + 'FILE'.padEnd(42) + 'CATEGORY'.padEnd(12) + 'SIZE');
        for (const file of items) {
          print('  ◯ ' + file.title.padEnd(40) + file.category.padEnd(12) + file.size);
        }
      } else {
        for (const file of items) {
          print('  ◯ ' + file.title);
          print('      ' + file.category + ' · ' + file.size);
        }
      }
      print('');
      printMuted(items.length + ' file(s). Use "cat <file>", "read <file>", or "open <file>".');
    }

    function tree() {
      if (!index) return printMuted('Still loading the index.');
      print('/');
      for (const section of index.sections) {
        if (section.path === '/' || section.name === 'FILES') continue;
        print('  ' + section.name.toLowerCase() + '/');
      }
      print('  files/');
      for (const cat of categories()) {
        print('    ' + cat + '/');
        for (const entry of entriesInCategory(cat)) {
          print('      ' + (entry.download ? basename(entry.download) : entry.id));
        }
      }
      print('    kits/');
      print('  search/');
      print('  index.json');
      print('  search.json');
      print('  feed.json');
      print('  llms.txt');
      print('  llms-small.txt');
      print('  llms-full.txt');
      print('  rss.xml');
    }

    function showMeta(entry, json) {
      if (json) return jsonOut(entry);
      print('  ◯ ' + entry.title);
      print('  id:        ' + entry.id);
      print('  category:  ' + entry.category);
      print('  updated:   ' + entry.date);
      print('  version:   ' + entry.version);
      print('  format:    ' + entry.format + ' · ' + entry.size + (entry.bytes ? ' (' + entry.bytes + ' bytes)' : ''));
      print('  license:   ' + entry.license);
      if (entry.tags && entry.tags.length) print('  tags:      ' + entry.tags.join(' · '));
      if (entry.sha256) print('  sha256:    ' + entry.sha256);
      if (entry.source) print('  source:    ' + entry.source);
      if (entry.download) print('  download:  ' + entry.download);
      print('  page:      ' + entry.url);
      print('');
      print(entry.summary);
      print('');
      printMuted('read ' + entry.id + ' · verify ' + entry.id + ' · open ' + entry.id);
    }

    async function fileText(entry) {
      if (!entry.download) throw new Error('File is not mirrored on this site.');
      const res = await fetch(entry.download, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.text();
    }

    async function readEntry(entry, json) {
      try {
        const text = await fileText(entry);
        if (json) return jsonOut({ ...entry, text });
        print(text);
      } catch (error) {
        printMuted('Could not read file: ' + error.message);
      }
    }

    async function headTail(entry, count, fromEnd) {
      try {
        const text = await fileText(entry);
        const lines = text.split('\n');
        const n = Number.isFinite(count) && count > 0 ? count : 20;
        const slice = fromEnd ? lines.slice(-n) : lines.slice(0, n);
        print(slice.join('\n'));
        printMuted('— ' + slice.length + ' of ' + lines.length + ' lines');
      } catch (error) {
        printMuted('Could not read file: ' + error.message);
      }
    }

    function hex(buffer) {
      return Array.from(new Uint8Array(buffer))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    }

    async function verify(entry, json) {
      if (!entry.download) return printMuted('No downloadable file for ' + entry.title + '.');
      if (!entry.sha256) return printMuted('No published checksum for ' + entry.title + '.');
      printMuted('Downloading ' + basename(entry.download) + ' …');
      try {
        const res = await fetch(entry.download, { cache: 'no-store' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const buffer = await res.arrayBuffer();
        const actual = hex(await crypto.subtle.digest('SHA-256', buffer));
        const ok = actual === entry.sha256;
        if (json) return jsonOut({ id: entry.id, expected: entry.sha256, actual, ok });
        print('  file:      ' + entry.download);
        print('  expected:  ' + entry.sha256);
        print('  actual:    ' + actual);
        print('');
        print(ok ? '  OK — checksum matches.' : '  MISMATCH — do not use this file.');
      } catch (error) {
        printMuted('Verification failed: ' + error.message);
      }
    }

    async function search(term, json) {
      if (!term) return printMuted('Usage: search <term>');
      if (!searchData) {
        printMuted('Loading search index …');
        try {
          const res = await fetch('/search.json', { cache: 'no-store' });
          searchData = await res.json();
        } catch (error) {
          return printMuted('Could not load /search.json.');
        }
      }
      const needle = term.toLowerCase();
      const results = [];
      for (const doc of searchData.docs) {
        const lines = doc.text.split('\n');
        const contexts = [];
        let matches = 0;

        const meta = [];
        if (doc.title.toLowerCase().includes(needle)) meta.push('title: ' + doc.title);
        if ((doc.tags || []).some((tag) => tag.toLowerCase().includes(needle))) {
          meta.push('tags: ' + doc.tags.join(', '));
        }
        if ((doc.summary || '').toLowerCase().includes(needle)) {
          meta.push('summary: ' + doc.summary);
        }
        matches += meta.length;
        contexts.push(...meta);

        for (const line of lines) {
          if (line.toLowerCase().includes(needle)) {
            matches += 1;
            if (contexts.length < 2) contexts.push(line.trim().slice(0, 180));
          }
        }
        if (matches) {
          results.push({ id: doc.id, title: doc.title, url: doc.url, matches, contexts });
        }
      }
      if (json) return jsonOut({ term, results });
      if (!results.length) return printMuted('No matches for "' + term + '".');
      const total = results.reduce((sum, r) => sum + r.matches, 0);
      print(total + ' match(es) in ' + results.length + ' file(s):');
      for (const result of results) {
        print('');
        print('  ◯ ' + result.title + '  (' + result.matches + ')');
        for (const line of result.contexts) print('      ' + line);
      }
      print('');
      printMuted('Open the file: cat <file> · read <file>');
    }

    async function status(json) {
      const state = { github: null, sites: [] };
      try {
        const res = await fetch('https://www.githubstatus.com/api/v2/status.json', { cache: 'no-store' });
        const data = await res.json();
        state.github = { indicator: data.status.indicator, description: data.status.description };
      } catch (error) {
        state.github = { indicator: 'unknown', description: 'Unavailable' };
      }
      for (const site of (index ? index.sites : [])) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 8000);
        const start = performance.now();
        try {
          await fetch(site.url, { mode: 'no-cors', cache: 'no-store', signal: controller.signal });
          state.sites.push({ name: site.name, url: site.url, reachable: true, ms: Math.round(performance.now() - start) });
        } catch (error) {
          state.sites.push({ name: site.name, url: site.url, reachable: false, ms: null });
        } finally {
          clearTimeout(timer);
        }
      }
      if (json) return jsonOut(state);
      if (state.github) {
        print('  GitHub: ' + state.github.description + ' (' + state.github.indicator + ')');
      }
      for (const site of state.sites) {
        print('  ' + site.name + ': ' + (site.reachable ? 'reachable (' + site.ms + ' ms)' : 'unreachable'));
      }
      printMuted('Full dashboard: /status/');
    }

    function stats(json) {
      const counts = {};
      let bytes = 0;
      for (const file of index.files) {
        counts[file.category] = (counts[file.category] || 0) + 1;
        bytes += file.bytes || 0;
      }
      const payload = {
        files: index.files.length,
        byCategory: counts,
        links: index.links.length,
        totalBytes: bytes,
        generated: index.generated,
      };
      if (json) return jsonOut(payload);
      print('  files:      ' + payload.files + ' (' + Object.entries(counts).map(([k, v]) => k.toLowerCase() + ' ' + v).join(', ') + ')');
      print('  links:      ' + payload.links);
      print('  total size: ' + (bytes / 1024).toFixed(1) + ' KB');
      print('  generated:  ' + payload.generated);
    }

    function simpleHelp(command) {
      if (command && HELP[command]) {
        print(HELP[command]);
        return;
      }
      if (command) return printMuted('No help for "' + command + '".');
      print('Commands:');
      for (const [name, text] of Object.entries(HELP)) {
        const [usage, description] = text.split(' — ');
        if (isWide()) {
          print('  ' + usage.padEnd(30) + description);
        } else {
          print('  ' + usage);
          print('      ' + description);
        }
      }
      print('');
      printMuted('Flags: --json  ·  Paths: /, /files, /files/<category>  ·  Slugs also work.');
      printMuted('Agents: /cli/manual.txt · /AGENTS.md · /cli/commands.json · /cli/manifest.tsv');
      printMuted('Machine: /cli/files.txt · /cli/context/<id>.txt · /index.json · /search.json · /cli/licenses.json');
      printMuted('Browser shortcuts: /cli/?cmd=search%20license · /cli/?cmd=files%20COPYLEFT');
    }

    function resolveOrWarn(target) {
      const entry = resolveEntry(target);
      if (!entry) printMuted('No such file: ' + (target || '(none)'));
      return entry;
    }

    let licensesData = null;
    let resourcesData = null;

    async function fetchTextFile(url) {
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + url);
      return res.text();
    }

    async function fetchJsonFile(url) {
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) throw new Error('HTTP ' + res.status + ' for ' + url);
      return res.json();
    }

    function absolutePath(pathname) {
      return location.origin + pathname;
    }

    function citationText(entry) {
      const parts = [
        entry.title + ' (v' + entry.version + ', ' + entry.date + ').',
        'Original.',
        absolutePath(entry.url),
      ];
      if (entry.sha256) parts.push('SHA-256: ' + entry.sha256 + '.');
      if (entry.source) parts.push('Source: ' + entry.source + '.');
      return parts.join(' ');
    }

    function relatedEntries(entry, limit = 3) {
      if (!index) return [];
      const tags = new Set(entry.tags || []);
      return index.files
        .filter((file) => file.id !== entry.id)
        .map((file) => {
          const shared = (file.tags || []).filter((tag) => tags.has(tag)).length;
          const sameCategory = file.category === entry.category ? 1 : 0;
          return { file, score: shared * 2 + sameCategory };
        })
        .filter((item) => item.score > 0)
        .sort((a, b) => b.score - a.score || a.file.title.localeCompare(b.file.title))
        .slice(0, limit)
        .map((item) => item.file);
    }

    async function getLicensesData() {
      if (!licensesData) licensesData = await fetchJsonFile('/cli/licenses.json');
      return licensesData;
    }

    async function getResourcesData() {
      if (!resourcesData) resourcesData = await fetchJsonFile('/cli/resources.json');
      return resourcesData;
    }

    function printResources(data, category) {
      const needle = (category || '').toUpperCase();
      const items = needle
        ? data.resources.filter((resource) => resource.category === needle)
        : data.resources;
      if (!items.length) return printMuted('No resources in ' + (needle || 'this site') + '.');
      let current = '';
      for (const resource of items) {
        if (resource.category !== current) {
          const count = items.filter((item) => item.category === resource.category).length;
          print('');
          print(resource.category + ' (' + count + ')');
          current = resource.category;
        }
        print('  ◯ ' + resource.title + '  [' + resource.id + ']');
        print('    ' + (resource.official ? 'official' : 'template') + ' · ' + resource.size + ' · ' + resource.format);
        if (resource.source) print('    source: ' + resource.source);
        print('    page:   ' + resource.page);
      }
      print('');
      printMuted('resources <category> · --json · static: /cli/resources.json');
    }

    function licenseCell(value) {
      return value === 'yes' ? '✓' : value === 'source' ? 'SOURCE' : '—';
    }

    function printLicenseDetail(data, license) {
      print('  ' + license.name + ' (' + license.id + ')');
      print('  SPDX:      ' + license.spdx);
      print('  page:      ' + absolutePath(license.page));
      if (license.download) print('  download:  ' + absolutePath(license.download));
      if (license.sha256) print('  sha256:    ' + license.sha256);
      print('');

      for (const group of data.groups) {
        print('  ' + group);
        for (const feature of data.features.filter((item) => item.group === group)) {
          const value = license.values[group]?.[feature.key] ?? 'no';
          print('    ' + feature.label.padEnd(30) + licenseCell(value));
        }
        print('');
      }
      printMuted('Comparison aid, not legal advice. Source: ' + data.source);
    }

    function printLicensesTable(data) {
      print('  LICENSES (' + data.licenses.length + ')');
      for (const license of data.licenses) {
        print('  ' + license.id.padEnd(16) + license.name.padEnd(20) + license.spdx);
      }
      print('');
      printMuted('licenses <id> · compare <id...> · static: /cli/licenses.json');
    }

    function printCompare(data, selected) {
      print('LICENSE COMPARE — ' + selected.map((license) => license.name).join(' · '));
      print('');
      for (const group of data.groups) {
        print(group);
        for (const feature of data.features.filter((item) => item.group === group)) {
          const cells = selected.map((license) => {
            const value = license.values[group]?.[feature.key] ?? 'no';
            return licenseCell(value).padEnd(10);
          });
          print('  ' + feature.label.padEnd(30) + cells.join(''));
        }
        print('');
      }
      printMuted('Comparison aid, not legal advice. Source: ' + data.source);
    }

    async function run(raw) {
      const line = raw.trim();
      if (!line) return;
      print('original ' + cwd + ' $ ' + line);

      const wantsJson = /(^|\s)--json(\s|$)/.test(line);
      const cleaned = line.replace(/(^|\s)--json(\s|$)/g, ' ').trim();
      const tokens = (cleaned.match(/(?:[^\s"]+|"[^"]*")+/g) || []).map((t) =>
        t.replace(/^"|"$/g, ''),
      );
      const command = (tokens[0] || '').toLowerCase();
      const args = tokens.slice(1);

      const offlineSafe = ['help', 'man', 'manual', 'agents', 'api', 'manifest', 'sitemap', 'licenses', 'resources', 'kits', 'guides', 'data', 'downloads', 'compare', 'date', 'whoami', 'source', 'clear', 'cls', 'exit', 'quit', 'echo'];
      if (!index && !offlineSafe.includes(command)) {
        return printMuted('The index is not loaded. Try refreshing the page.');
      }

      if (command === 'help' || command === 'man') simpleHelp(args[0]);
      else if (command === 'ls') {
        const long = args.includes('-l');
        const pathArg = args.filter((a) => !a.startsWith('-'))[0];
        const target = normalizePath(pathArg);
        if (wantsJson) {
          const items = listDir(target);
          return jsonOut(items ? { path: target, items } : { path: target, error: 'not a directory' });
        }
        printEntries(target, long);
      } else if (command === 'cd') {
        const target = normalizePath(args[0] || '/');
        if (target === '/' || target === '/files' || /^\/files\/(licenses|standards|snippets|headers|policies|governance|agents)$/.test(target) || sectionForPath(target)) {
          cwd = target;
          setPrompt();
        } else {
          printMuted('Not a directory: ' + target);
        }
      } else if (command === 'pwd') {
        print(cwd);
      } else if (command === 'tree') {
        tree();
      } else if (command === 'files' || command === 'list') {
        listFiles(args[0] || null, wantsJson);
      } else if (command === 'cat' || command === 'meta') {
        const entry = resolveOrWarn(args[0]);
        if (entry) showMeta(entry, wantsJson);
      } else if (command === 'read' || command === 'get') {
        const entry = resolveOrWarn(args[0]);
        if (entry) await readEntry(entry, wantsJson);
      } else if (command === 'head' || command === 'tail') {
        const entry = resolveOrWarn(args[0]);
        if (entry) await headTail(entry, args[1] ? parseInt(args[1], 10) : 20, command === 'tail');
      } else if (command === 'search' || command === 'grep' || command === 'find') {
        await search(args.join(' ').trim(), wantsJson);
      } else if (command === 'manual') {
        try {
          print(await fetchTextFile('/cli/manual.txt'));
        } catch (error) {
          printMuted('Could not load manual: ' + error.message);
        }
      } else if (command === 'agents') {
        try {
          print(await fetchTextFile('/AGENTS.md'));
        } catch (error) {
          printMuted('Could not load AGENTS.md: ' + error.message);
        }
      } else if (command === 'api') {
        try {
          const data = await fetchJsonFile('/cli/commands.json');
          if (wantsJson) return jsonOut(data);
          print('ENDPOINTS');
          for (const endpoint of data.endpoints) {
            print('  ' + endpoint.path.padEnd(34) + String(endpoint.format).padEnd(24) + endpoint.description);
          }
          print('');
          print('COMMANDS');
          for (const item of data.commands) {
            print('  ' + item.usage.padEnd(32) + item.description);
          }
        } catch (error) {
          printMuted('Could not load API manifest: ' + error.message);
        }
      } else if (command === 'context') {
        const entry = resolveOrWarn(args[0]);
        if (!entry) return;
        if (wantsJson) {
          try {
            const text = await fileText(entry);
            return jsonOut({
              ...entry,
              text,
              citation: citationText(entry),
              related: relatedEntries(entry).map((item) => ({
                id: item.id,
                title: item.title,
                url: item.url,
              })),
            });
          } catch (error) {
            return printMuted('Could not build context: ' + error.message);
          }
        }
        try {
          print(await fetchTextFile('/cli/context/' + entry.id + '.txt'));
        } catch (error) {
          printMuted('Could not load context pack: ' + error.message);
        }
      } else if (command === 'cite') {
        const entry = resolveOrWarn(args[0]);
        if (!entry) return;
        const citation = citationText(entry);
        if (wantsJson) return jsonOut({ id: entry.id, citation });
        print(citation);
      } else if (command === 'related') {
        const entry = resolveOrWarn(args[0]);
        if (!entry) return;
        const related = relatedEntries(entry);
        if (wantsJson) return jsonOut(related);
        if (!related.length) return printMuted('No related files.');
        for (const item of related) {
          print('  ◯ ' + item.title + '  (' + item.category + ')\n      ' + item.url);
        }
      } else if (command === 'manifest') {
        try {
          const text = await fetchTextFile('/cli/manifest.tsv');
          if (wantsJson) {
            const lines = text.trim().split('\n');
            const header = lines.shift().split('\t');
            return jsonOut(
              lines.map((line) => {
                const cells = line.split('\t');
                return Object.fromEntries(header.map((key, index) => [key, cells[index] ?? '']));
              }),
            );
          }
          print(text);
        } catch (error) {
          printMuted('Could not load manifest: ' + error.message);
        }
      } else if (command === 'sitemap') {
        try {
          print(await fetchTextFile('/cli/sitemap.txt'));
        } catch (error) {
          printMuted('Could not load sitemap: ' + error.message);
        }
      } else if (command === 'licenses') {
        try {
          const data = await getLicensesData();
          if (args[0]) {
            const needle = args[0].toLowerCase();
            const license = data.licenses.find(
              (item) =>
                item.id === needle ||
                item.spdx.toLowerCase() === needle ||
                item.name.toLowerCase() === needle,
            );
            if (!license) return printMuted('No such license: ' + args[0]);
            if (wantsJson) return jsonOut(license);
            printLicenseDetail(data, license);
          } else {
            if (wantsJson) return jsonOut(data);
            printLicensesTable(data);
          }
        } catch (error) {
          printMuted('Could not load licenses: ' + error.message);
        }
      } else if (command === 'resources') {
        try {
          const data = await getResourcesData();
          if (wantsJson) {
            const needle = (args[0] || '').toUpperCase();
            return jsonOut(needle ? { ...data, resources: data.resources.filter((resource) => resource.category === needle) } : data);
          }
          printResources(data, args[0]);
        } catch (error) {
          printMuted('Could not load resources: ' + error.message);
        }
      } else if (command === 'kits') {
        try {
          const data = await fetchJsonFile('/kits/index.json');
          if (wantsJson) return jsonOut(data);
          print('KITS (' + data.kits.length + ')');
          for (const kit of data.kits) {
            print('  ◯ ' + kit.name + '  [' + kit.id + ']');
            print('    ' + kit.files.length + ' files + KIT.txt · ' + kit.bytes + ' bytes · ' + kit.download);
            print('    ' + kit.page);
          }
          print('');
          printMuted('open <kit page> · download <zip> · static: /kits/index.json');
        } catch (error) {
          printMuted('Could not load kits: ' + error.message);
        }
      } else if (command === 'guides') {
        try {
          const data = await fetchJsonFile('/guides.json');
          if (wantsJson) return jsonOut(data);
          print('GUIDES (' + data.guides.length + ')');
          for (const guide of data.guides) {
            print('  ◯ ' + guide.title + '  [' + guide.id + ']');
            print('    ' + guide.audience + ' · ' + guide.readingTime + ' · ' + guide.url);
          }
          print('');
          printMuted('open <guide> · static: /guides.json');
        } catch (error) {
          printMuted('Could not load guides: ' + error.message);
        }
      } else if (command === 'data') {
        try {
          const data = await fetchJsonFile('/data/index.json');
          if (wantsJson) return jsonOut(data);
          print('DATA (' + data.datasets.length + ')');
          for (const dataset of data.datasets) {
            print('  ◯ ' + dataset.title + '  [' + dataset.id + ']');
            print('    ' + dataset.rows + ' rows · ' + dataset.json);
          }
          print('');
          printMuted('open <dataset> · static: /data/index.json');
        } catch (error) {
          printMuted('Could not load data: ' + error.message);
        }
      } else if (command === 'downloads') {
        try {
          const data = await fetchJsonFile('/downloads/index.json');
          if (wantsJson) return jsonOut(data);
          print('DOWNLOADS (' + data.downloads.length + ')');
          for (const item of data.downloads) {
            print('  ◯ ' + item.name + '  [' + item.id + ']');
            print('    ' + item.files + ' entries · ' + item.bytes + ' bytes · ' + item.download);
          }
          print('');
          printMuted('static: /downloads/index.json');
        } catch (error) {
          printMuted('Could not load downloads: ' + error.message);
        }
      } else if (command === 'compare') {
        try {
          const data = await getLicensesData();
          const ids = (args.length ? args : data.defaults).map((item) => item.toLowerCase());
          const selected = ids
            .map((id) =>
              data.licenses.find(
                (license) =>
                  license.id === id ||
                  license.spdx.toLowerCase() === id ||
                  license.name.toLowerCase() === id,
              ),
            )
            .filter(Boolean);
          if (selected.length < 2) {
            return printMuted('Provide at least two license ids, for example: compare mit gpl-3.0 mpl-2.0');
          }
          if (wantsJson) return jsonOut({ licenses: selected, features: data.features, source: data.source });
          printCompare(data, selected);
        } catch (error) {
          printMuted('Could not compare licenses: ' + error.message);
        }
      } else if (command === 'verify' || command === 'sha256') {
        const entry = resolveOrWarn(args[0]);
        if (entry) await verify(entry, wantsJson);
      } else if (command === 'download') {
        const entry = resolveOrWarn(args[0]);
        if (!entry) return;
        if (!entry.download) return printMuted('No downloadable file for ' + entry.title + '.');
        const anchor = document.createElement('a');
        anchor.href = entry.download;
        anchor.download = basename(entry.download);
        document.body.appendChild(anchor);
        anchor.click();
        anchor.remove();
        print('Download started: ' + basename(entry.download));
      } else if (command === 'open') {
        const target = args[0];
        if (!target) return printMuted('Usage: open <section|file|url>');
        if (/^https?:\/\//.test(target)) {
          window.open(target, '_blank', 'noopener');
          return;
        }
        const entry = resolveEntry(target);
        if (entry) {
          window.location.href = entry.url;
          return;
        }
        const section = sectionForPath(normalizePath(target));
        if (section) {
          window.location.href = section.path;
          return;
        }
        if (target.startsWith('/')) {
          window.location.href = target;
          return;
        }
        printMuted('Nothing called "' + target + '". Try ls.');
      } else if (command === 'status') {
        await status(wantsJson);
      } else if (command === 'links') {
        if (wantsJson) return jsonOut(index.links);
        for (const link of index.links) print('  ' + link.name + '\n      ' + link.url);
      } else if (command === 'tools') {
        if (wantsJson) return jsonOut(index.tools || []);
        for (const tool of index.tools || []) {
          print('  ' + tool.name + '  ' + tool.url + '\n      ' + tool.description);
        }
      } else if (command === 'contact') {
        print('  email:  contact@original.wales');
        print('  github: https://github.com/Verlintas');
      } else if (command === 'stats') {
        stats(wantsJson);
      } else if (command === 'about') {
        print('Original — files with stable addresses, live status, and small tools.');
        print('Maintained by Verlintas. See /about/ for details.');
      } else if (command === 'date') {
        print(new Date().toString());
      } else if (command === 'whoami') {
        print('guest — human or agent');
      } else if (command === 'source') {
        print('https://github.com/Verlintas/original');
      } else if (command === 'history') {
        history.forEach((item, i) => print('  ' + (i + 1) + '  ' + item));
      } else if (command === 'clear' || command === 'cls') {
        output.replaceChildren();
      } else if (command === 'exit' || command === 'quit') {
        printMuted('Leaving the shell…');
        window.location.href = '/';
      } else if (command === 'echo') {
        print(args.join(' '));
      } else {
        printMuted('command not found: ' + command + ' — type help');
      }
    }

    function currentToken() {
      const pos = input.selectionStart ?? input.value.length;
      const before = input.value.slice(0, pos);
      const parts = before.split(/\s+/);
      const token = parts[parts.length - 1] || '';
      return { token, start: pos - token.length, firstWord: parts.filter(Boolean).length <= 1 };
    }

    function getCompletions(command, token) {
      if (!index) return [];
      const prefix = token.toLowerCase();
      if (!command) return COMMANDS.filter((c) => c.startsWith(prefix));

      if (command === 'files') {
        return categories().filter((c) => c.startsWith(prefix));
      }
      if (command === 'open') {
        const sectionPaths = index.sections.map((s) => s.name.toLowerCase());
        const slugs = index.files.map((f) => f.id);
        return [...sectionPaths, ...slugs].filter((v) => v.startsWith(prefix));
      }
      if (command === 'cd') {
        const dirs = dirsOnly(cwd);
        return dirs.filter((v) => v.startsWith(prefix));
      }
      if (['cat', 'read', 'head', 'tail', 'verify', 'download', 'ls'].includes(command)) {
        const items = listDir(cwd) || [];
        const names = items.map((item) => (item.kind === 'dir' ? item.name + '/' : item.name));
        const slugs = index.files.map((f) => f.id);
        return [...new Set([...names, ...slugs])].filter((v) => v.startsWith(prefix));
      }
      return [];
    }

    function complete() {
      const { token, start, firstWord } = currentToken();
      const before = input.value.slice(0, start);
      const command = firstWord ? '' : (before.trim().split(/\s+/)[0] || '').toLowerCase();
      const options = getCompletions(command, token);
      if (!options.length) return;
      if (options.length === 1) {
        const value = before + options[0] + (firstWord ? ' ' : ' ');
        input.value = value;
        input.setSelectionRange(value.length, value.length);
      } else {
        printMuted('  ' + options.join('   '));
      }
    }

    async function boot() {
      printMuted('ORIGINAL — shell · type help or manual · --json for machine output');
      print('');
      try {
        const res = await fetch('/index.json', { cache: 'no-store' });
        index = await res.json();
        printMuted(
          'Index loaded: ' + index.files.length + ' files · ' + index.links.length + ' links · ' +
            new Date(index.generated).toISOString().slice(0, 10),
        );
      } catch (error) {
        printMuted('Could not load /index.json. Commands that need content will not work.');
      }
      print('');

      const requested = new URLSearchParams(window.location.search).get('cmd');
      if (requested) {
        for (const part of requested.replace(/&&/g, ';').split(';')) {
          await run(part);
        }
        print('');
      }

      input.focus();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (busy) return;
      const value = input.value;
      input.value = '';
      if (!value.trim()) return;
      busy = true;
      history.push(value);
      historyPos = history.length;
      try {
        await run(value);
      } catch (error) {
        printMuted('error: ' + error.message);
      }
      busy = false;
      setPrompt();
      input.focus();
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (historyPos > 0) {
          historyPos -= 1;
          input.value = history[historyPos] || '';
        }
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (historyPos < history.length - 1) {
          historyPos += 1;
          input.value = history[historyPos] || '';
        } else {
          historyPos = history.length;
          input.value = '';
        }
      } else if (event.key === 'Tab') {
        event.preventDefault();
        complete();
      } else if (event.key === 'l' && (event.ctrlKey || event.metaKey)) {
        event.preventDefault();
        output.replaceChildren();
      } else if (event.key === 'c' && event.ctrlKey) {
        event.preventDefault();
        input.value = '';
      }
    });

    document.querySelector('.cli-screen').addEventListener('click', () => input.focus());

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') window.location.href = '/';
    });

    boot();
  </script>
</BaseLayout>
