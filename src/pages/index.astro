---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import Circle from '../components/Circle.astro';
import FileTable from '../components/FileTable.astro';

const files = (await getCollection('files')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title),
);
const latest = files.slice(0, 4);

const index = [
  { href: '/status/', label: 'STATUS', note: 'Live checks and projects' },
  { href: '/files/', label: 'FILES', note: 'Licenses, headers, policies, governance' },
  { href: '/universe/', label: 'UNIVERSE', note: 'Tools and experiments' },
  { href: '/about/', label: 'ABOUT', note: 'The site and its maintainer' },
];
---

<BaseLayout title="Original">
  <section class="masthead">
    <h1 class="site-title"><Circle /> <span>Original</span></h1>
    <div>
      <p class="intro">Files, status, tools, and other useful things.</p>
      <nav class="quick-nav" aria-label="Sections">
        {index.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </div>
  </section>

  <div class="home-grid">
    <section aria-labelledby="recent-files">
      <div class="section-head">
        <h2 id="recent-files" class="label">Files</h2>
        <span class="section-count">{files.length} total</span>
      </div>
      <FileTable entries={latest} />
      <p class="more"><a class="action" href="/files/">[ ALL FILES ]</a></p>
    </section>

    <section aria-labelledby="index-heading">
      <div class="section-head">
        <h2 id="index-heading" class="label">Index</h2>
      </div>
      <ul class="index-list">
        {
          index.map((item) => (
            <li>
              <a class="index-name" href={item.href}><Circle /> {item.label}</a>
              <span class="index-note">{item.note}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
