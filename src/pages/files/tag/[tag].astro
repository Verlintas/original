---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../components/BaseLayout.astro';
import Circle from '../../../components/Circle.astro';
import FileTable from '../../../components/FileTable.astro';
import { slugify } from '../../../utils/slug';

export async function getStaticPaths() {
  const files = await getCollection('files');
  const tags = [...new Set(files.flatMap((entry) => entry.data.tags ?? []))].sort();
  const used = new Map();
  return tags.map((tag) => {
    const base = slugify(tag) || 'tag';
    let slug = base;
    let index = 2;
    while (used.has(slug)) {
      slug = `${base}-${index}`;
      index += 1;
    }
    used.set(slug, tag);
    return { params: { tag: slug }, props: { tag } };
  });
}

const { tag } = Astro.props;
const files = (await getCollection('files'))
  .filter((entry) => (entry.data.tags ?? []).includes(tag))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={`TAG: ${tag}`} description={`Files tagged ${tag} on Original.`}>
  <p class="back"><a href="/files/">← All files</a></p>

  <header class="page-head">
    <h1 class="page-title"><Circle /> {tag}</h1>
    <p class="lede">{files.length} files share this tag. Every entry names its source and carries a checksum.</p>
  </header>

  <FileTable entries={files} showTags />

  <p class="back" style="margin-top: 3rem;"><a href="/files/">← All files</a></p>
</BaseLayout>
