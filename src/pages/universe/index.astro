---
import BaseLayout from '../../components/BaseLayout.astro';
import Circle from '../../components/Circle.astro';
import { tools } from '../../data/tools';
---

<BaseLayout
  title="UNIVERSE"
  description="Small public tools for licensing, privacy, accessibility, security, and data."
>
  <header class="page-head">
    <h1 class="page-title"><Circle /> UNIVERSE</h1>
    <p class="lede">
      Small public tools. Each tool has its own room; everything runs in the browser and nothing is
      uploaded.
    </p>
  </header>

  <div class="tool-grid" style="margin-top: 2rem;">
    {
      tools.map((tool) => (
        <a class="tool-card" href={tool.url}>
          <span class="tool-index">{tool.index}</span>
          <h3>{tool.name}</h3>
          <p>{tool.description}</p>
          <span class="tool-arrow">[ OPEN ]</span>
        </a>
      ))
    }
  </div>

  <p class="compare-legend" style="margin-top: 2rem;">
    Embed a tool with <code>?embed=1</code>; see <a href="/embed/">EMBED</a>.
    Suggestions: <a href="mailto:contact@original.wales">contact@original.wales</a>.
  </p>
</BaseLayout>
