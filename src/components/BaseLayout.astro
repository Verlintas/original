---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  bare?: boolean;
  theme?: 'default' | 'cli';
}

const {
  title,
  description = 'A cornerstone for files, references, and tools.',
  type = 'website',
  noindex = false,
  bare = false,
  theme = 'default',
} = Astro.props;

const siteName = 'Original';
const pageTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class:list={[theme === 'cli' && 'theme-cli']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Original" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Original JSON Feed" href="/feed.json" />
    <link rel="search" type="application/opensearchdescription+xml" title="Original" href="/opensearch.xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Original",
      url: canonical.href,
      description,
      potentialAction: {
        "@type": "SearchAction",
        target: new URL("/search/?q={search_term_string}", Astro.site).href,
        "query-input": "required name=search_term_string",
      },
    })} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class:list={[`theme-${theme}`]}>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip-link visually-hidden" href="#main">Skip to content</a>
          <Header />
          <main id="main">
            <div class="shell">
              <slot />
            </div>
          </main>
          <Footer />
        </>
      )
    }
    <script is:inline>
      if (new URLSearchParams(location.search).has('embed')) document.body.classList.add('is-embed');
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
    <style>
      .skip-link:focus {
        position: fixed;
        left: 1rem;
        top: 1rem;
        width: auto;
        height: auto;
        clip: auto;
        background: var(--bg);
        color: var(--red);
        border: 1px solid var(--red);
        padding: 0.4rem 0.8rem;
        font-family: var(--font-sans);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        z-index: 10;
      }
    </style>
  </body>
</html>
