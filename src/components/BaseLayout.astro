---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = 'Files, status, tools, and other useful things.',
  type = 'website',
  noindex = false,
} = Astro.props;

const siteName = 'Original';
const pageTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Original" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class="shell">
        <slot />
      </div>
    </main>
    <Footer />
    <style>
      .skip-link:focus {
        position: fixed;
        left: 1rem;
        top: 1rem;
        width: auto;
        height: auto;
        clip: auto;
        background: var(--bg);
        color: var(--red);
        border: 1px solid var(--red);
        padding: 0.4rem 0.8rem;
        font-family: var(--font-sans);
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        z-index: 10;
      }
    </style>
  </body>
</html>
